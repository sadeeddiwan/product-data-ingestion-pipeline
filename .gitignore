# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*

# ── Logs (regenerated on every run) ──────────────────────────────────────────
logs/*.log

# ── Intermediate data (regenerated by pipeline) ───────────────────────────────
data/raw/
data/processed/

# ── SQLite database ───────────────────────────────────────────────────────────
